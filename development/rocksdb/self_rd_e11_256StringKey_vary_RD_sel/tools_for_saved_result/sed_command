for dir in log*/; do
    dir="${dir%/}"   # remove trailing slash if you want
    echo "Processing $dir..."
    cd "$dir"
    
    # Extract number from directory name
    # number=$(echo "$dir" | grep -o '[0-9]*')
    number=5000
    
    grep -ie "_out = " log* > out_log.txt

    # Copy and modify the Python script
    cp ../parsing_log_file.py ./
    sed -i "s/number_of_pq_on_currently_non_inserted_keys = [0-9]*/number_of_pq_on_currently_non_inserted_keys = $number/" parsing_log_file.py
    
    grep -ie "_out = " log* > out_log.txt
    sed -i 's/)\ .*\ fetcher/)\ fetcher/g' out_log.txt
    python3 parsing_log_file.py
    cd ..
done


